# Required: Fish Audio (JARVIS's voice)
FISH_API_KEY=your-fish-audio-api-key-here

# JARVIS's brain is a Claude Code process running on YOUR Claude subscription.
# Install Claude Code (2.1.224+) and log in with `claude` — no Anthropic API
# key is needed for anything, and any ANTHROPIC_* variable set here is
# deliberately hidden from the brain so it can only use your login.

# Optional: which model the brain runs (default sonnet; always passed explicitly)
# JARVIS_BRAIN_MODEL=sonnet

# Optional: while Claude's usage limit holds, ChatGPT stands in (the Codex
# CLI, on your ChatGPT subscription) through the same tools and gates, and
# JARVIS goes back to Claude when the limit resets. Off unless set: switched
# on, the conversation goes to OpenAI. Sign Codex in for JARVIS first with
# `python scripts/chatgpt_setup.py login`. See docs/chatgpt-fallback.md.
# JARVIS_CHATGPT_FALLBACK=1
# JARVIS_CHATGPT_MODEL=gpt-5.5
# JARVIS_CODEX_PATH=C:\\path\\to\\codex.exe

# Optional: Fish Audio voice model (defaults to JARVIS MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Optional: which Fish Audio TTS model speaks. The default is the service's
# own (s2.1-pro), which is billed per character and answers 402 on an
# account with no credit. s2.1-pro-free is the free tier.
# FISH_MODEL=s2.1-pro-free

# Optional: Your name (JARVIS will address you by name)
# USER_NAME=Tony

# Optional: Whether to skip Claude CLI permission prompts on subprocess calls.
# Defaults to "true" because JARVIS is voice-driven and cannot respond to
# interactive permission prompts (they would silently hang the subprocess).
# Set to "false" to require explicit permission prompts — only useful when
# running JARVIS interactively in a Terminal you can see and respond to.
# JARVIS_SKIP_PERMISSIONS=true

# Optional: Override the auto-detected weather location.
# By default, JARVIS uses your public-IP location (via ipwho.is) and reports
# Fahrenheit. Set these to pin a specific location:
# WEATHER_LOCATION_LABEL=London
# WEATHER_LATITUDE=51.5072
# WEATHER_LONGITUDE=-0.1276
# WEATHER_UNIT=fahrenheit  # or "celsius"

# Optional: give JARVIS a Telegram bot so he can reach you when you are away
# from the desk — approval cards with Approve/Reject buttons, sessions waiting
# on you, failed or finished work (the urgent ones as a voice note in his
# voice) — and so you can text him back. The easier of the two lines: no
# phone number, no Facebook, no 24-hour window. In Telegram open @BotFather,
# send /newbot, paste the token here (or under Settings → Telegram), then
# press Pair there (or `python scripts/telegram_setup.py pair`) and send the
# code to the bot from your phone: that fills in TELEGRAM_OWNER_ID. Calls are
# NOT available (voice notes are); see docs/telegram.md.
# TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_OWNER_ID=424242001
# Let a button tap or "approve" on the phone decide a card (default on); send
# the urgent lines as a voice note too (default on).
# TELEGRAM_APPROVALS=1
# TELEGRAM_VOICE_NOTES=1

# Optional: give JARVIS a WhatsApp number so he can reach you when you are
# away from the desk — approval cards with Approve/Reject buttons, sessions
# waiting on you, failed or finished work (the urgent ones as a voice note
# in his voice) — and so you can text him back. The number comes from Kapso
# (kapso.ai; the free plan includes a pre-verified US number and 2,000
# messages a month). `python scripts/whatsapp_setup.py numbers` prints the
# phone number id once the key is set; see docs/whatsapp.md for the rest.
# Calls are NOT available (voice notes are); see docs/whatsapp.md for why.
# KAPSO_API_KEY=your-kapso-api-key
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Your own WhatsApp number, E.164. Falls back to JARVIS_OWNER_PHONE (the
# number the Twilio provider calls), so one line can serve both.
# WHATSAPP_OWNER_NUMBER=+14155550132
# An approved UTILITY template with one named body parameter `message`, used
# when more than 24 hours have passed since your last message to him and
# WhatsApp will not accept free-form text. `python scripts/whatsapp_setup.py
# template` creates one called jarvis_attention and tells you when Meta has
# approved it. Without it he cannot reach you outside that window.
# WHATSAPP_TEMPLATE=jarvis_attention
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Read your messages at all (default on); let a button tap or "approve" on
# the phone decide a card (default on); send the urgent lines as a voice note
# too (default on; each one is a Fish Audio synthesis).
# WHATSAPP_INBOUND=1
# WHATSAPP_APPROVALS=1
# WHATSAPP_VOICE_NOTES=1
# How often he reads the line: quickly for ten minutes after either of you
# has written, slowly otherwise. Kapso's free plan logs 100,000 API requests
# a month, which the defaults stay well under.
# WHATSAPP_POLL_HOT_SECONDS=3
# WHATSAPP_POLL_IDLE_SECONDS=20
# Only if he ignores your messages: some countries' WhatsApp ids differ from
# the E.164 number (Mexico, Argentina). The log names the number he ignored.
# WHATSAPP_OWNER_WA_ID=5215512345678

# How long a turn may be SILENT before the brain is judged stuck (seconds).
# Not how long a turn may TAKE: one waiting on a tool is alive.
# JARVIS_BRAIN_TURN_TIMEOUT=90
# The backstop under that hold: the most a whole turn may take, ever.
# JARVIS_BRAIN_TURN_CEILING=300
# How much CONVERSATION (tokens, over the resident floor of prompt and tool
# schemas) the brain holds before it hands over to a fresh generation at the
# next pause. Capped automatically so the floor plus this much stays within
# three quarters of the model's window (never below 20,000 on that account).
# See "Context rotation" in the README.
# JARVIS_BRAIN_CONTEXT_BUDGET=120000

# LinkedIn's official API (docs/linkedin.md). Your own app's credentials; you
# sign in yourself from the Business desk, and the token stays in the data folder.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_MEDIA_ROOTS=C:\dev\linkedin-media
# The company page, once LinkedIn grants its app the Community Management API:
# LINKEDIN_ORG_CLIENT_ID=
# LINKEDIN_ORG_CLIENT_SECRET=
# LINKEDIN_ORGANIZATION_ID=
# Interim limits; raise them yourself once the API route has run cleanly.
# LINKEDIN_POSTS_PER_DAY=1
# LINKEDIN_COMMENTS_PER_DAY=5
# LINKEDIN_MIN_POST_GAP_HOURS=6
